# Copy to .env and edit. Never commit .env.
HUB_PORT=8443
HUB_DATA_DIR=./hub-data
HUB_LOG_LEVEL=info
HUB_EVENT_RETENTION_DAYS=30

# Port published on the host. Change this if 8443 is already taken on your box.
# The port inside the container is always 8443.
HUB_PUBLISHED_PORT=8443

# The LAN address phones use to reach this hub. REQUIRED when running in
# Docker: the container cannot detect it, and a pairing QR built from the
# container's own address sends the phone nowhere.
HUB_PUBLIC_HOST=192.168.1.10
